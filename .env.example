# Telegram bot token from @BotFather
BOT_TOKEN=123456789:PUT_YOUR_TOKEN_HERE

# College timezone
TIMEZONE=Asia/Barnaul

# Local mode: keep this empty and the bot uses SQLite.
# Render mode: put a PostgreSQL connection string here.
DATABASE_URL=

# Optional local SQLite path when DATABASE_URL is empty.
DATABASE_PATH=data/schedule.db

# Render fills RENDER_EXTERNAL_URL automatically.
BASE_URL=

WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=change-this-to-a-random-secret
PORT=10000

# Automatic website scan interval.
# The scheduler aligns it to 00:00 / 06:00 / 12:00 / 18:00 in TIMEZONE.
SYNC_INTERVAL_HOURS=6
